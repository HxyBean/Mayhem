  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "MOVEMENT\r\nUse the left joystick to move your character around the map.\r\n\r\nCOMBAT\r\nYour
    weapon automatically aims and locks onto the nearest enemy \u2014 just tap the
    Attack button to fire. \r\nWatch your ammo (or mana, for the Mage). When it runs
    low, tap the Reload button to refill \u2014 you can't move faster while reloading,
    so time it carefully!\r\n\r\nSPECIAL MOVE\r\n- Gunner: tap the Dash button for
    a short burst of speed with a brief window of safety.\r\n- Mage: press and drag
    the Blink button to choose a spot within range, then release to instantly teleport
    there \u2014 perfect for escaping danger. Watch out for obstacles, and mind the
    cooldown!\r\n\r\nPICKUPS\r\n- XP Orbs (small / big / boss): fill your XP bar.
    Level up to choose a new Augment.\r\n- Energy: fills the Energy bar. Once it's
    full, the Boss appears!\r\n- USB: defeating the Boss drops a USB drive. Collect
    3 to WIN the run. Picking one up also fully heals you and revives the Boss for
    another round if you haven't collected enough yet.\r\n- Heart: some enemies drop
    a heart when defeated \u2014 walk over it to heal.\r\n\r\nAUGMENTS\r\nEvery time
    you level up, pick one of three Augments to power up your character \u2014 more
    damage, more speed, more max HP, life steal, faster reload, and character-exclusive
    cores like Burst Shot, Split Shot, Bomb (Gunner) or Mana Regen, Potion (Mage).
    Choose wisely, you can't undo it!\r\n\r\nGOAL\r\nSurvive, level up, and collect
    3 USB drives from the Boss to win the level. Beating a level unlocks the next
    one on the Stage Select screen.\r\n\r\nGood luck out there!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: f0f26f3a1a5a49b46ac915f3a383958d, type: 2}
